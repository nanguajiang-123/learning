# Example environment file for the project
# Copy this to .env and fill in real secrets before running the app.

DB_HOST=you_db_host
DB_PORT=you_port
DB_USER=you_db_user
DB_PASSWORD=you_db_password
DB_NAME=you_db_name
DB_SSLMODE=you_db_sslmode
DB_TIMEZONE=you_db_timezone

# JWT
JWT_SECRET=you_jwt_secret
JWT_METHOD=you_jwt_method
JWT_EXPIRE=you_jwt_expire

# Password hashing algorithm
PASSWORD_HASH=you_password_hash

# Redis
REDIS_HOST=you_redis_host
REDIS_DB=you_redis_db
REDIS_PASSWORD=you_redis_password
REDIS_PORT=you_redis_port

# App
APP_NAME=you_app_name
APP_ENV=you_app_env
DEBUG=you_debug
LOG_LEVEL=you_log_level
LOG_DIR=you_log_dir

API_HOST=you_api_host
API_PORT=you_api_port


